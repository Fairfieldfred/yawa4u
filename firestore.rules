rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Community templates ────────────────────────────────────────────
    match /community_templates/{docId} {
      // Anyone authenticated can read published templates.
      // Authors can also read their own templates (any status).
      allow read: if request.auth != null
                  && (resource.data.status == 'published'
                      || resource.data.authorUid == request.auth.uid);

      // Email-verified users can create templates.
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.authorUid == request.auth.uid;

      // Authors can update their own templates.
      // Any authenticated user can increment the download count.
      allow update: if request.auth != null
                    && (resource.data.authorUid == request.auth.uid
                        || request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['downloadCount']));

      // Authors can delete their own templates.
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // ── Community skins ────────────────────────────────────────────────
    match /community_skins/{docId} {
      // Anyone authenticated can read published skins.
      // Authors can also read their own skins (any status).
      allow read: if request.auth != null
                  && (resource.data.status == 'published'
                      || resource.data.authorUid == request.auth.uid);

      // Email-verified users can create skins.
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.authorUid == request.auth.uid;

      // Authors can update their own skins.
      // Any authenticated user can increment the download count.
      allow update: if request.auth != null
                    && (resource.data.authorUid == request.auth.uid
                        || request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['downloadCount']));

      // Authors can delete their own skins.
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }
  }
}
