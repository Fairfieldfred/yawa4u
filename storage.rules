rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Skin images ──────────────────────────────────────────────────
    match /skins/{docId}/{fileName} {
      // Anyone authenticated can read skin images.
      allow read: if request.auth != null;

      // Email-verified users can upload skin images (max 2 MB).
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
