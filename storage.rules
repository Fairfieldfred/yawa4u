rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Skin images ──────────────────────────────────────────────────
    match /skins/{docId}/{fileName} {
      // Anyone authenticated can read skin images.
      allow read: if request.auth != null;

      // Email-verified users can upload skin images (max 2 MB).
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.resource.size < 2 * 1024 * 1024;
    }

    // ── User cloud backups (max 50 MB) ───────────────────────────────
    match /user_backups/{uid}/{fileName} {
      // Owners can read their own backup blob.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Owners with a verified email can write/delete it.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.email_verified == true
                   && (request.resource == null
                       || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
